{
  "name": "@cstan0824/remembry-mcp",
  "version": "0.3.2",
  "description": "Remembry MCP Server — manage your meeting knowledge base via AI assistants. Recording requires the Remembry desktop app to be running.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "remembry-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "remembry",
    "meeting",
    "knowledge-base",
    "transcription",
    "ai",
    "notes",
    "action-items"
  ],
  "author": "kongjiyu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongjiyu/remembry-app.git",
    "directory": "mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
